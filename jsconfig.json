{
  "compilerOptions": {
    "target": "es5",
    "module": "esnext",
    "baseUrl": "./",
    "moduleResolution": "node",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ],
    "types": [
      "@types/node",
      "@types/eslint",
      "@types/eslint-scope",
      "@types/estree",
      "@types/html-minifier-terser",
      "@types/json-schema",
      "@types/minimist",
      "@types/normalize-package-data",
      "@types/parse-json"
    ],
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/ThemeSwitcher.vue"
  ]
}
